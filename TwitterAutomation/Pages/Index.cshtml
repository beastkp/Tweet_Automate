@page
@model IndexModel

@{
    ViewData["Title"] = "Tweet Discovery";
}

<div class="container">
    <h1>Top Tweets to Reply To</h1>
    <p class="subtitle">
        Curated developer conversations worth engaging with
    </p>

    @if (!Model.Tweets.Any())
    {
        <div class="empty">
            <p>No tweets found. Try again later.</p>
        </div>
    }
    else
    {
        <div class="tweet-list">
            @foreach (var item in Model.Tweets)
            {
                <div class="tweet-card">
                    <div class="metrics">
                        <span>❤️ @item.Tweet.Metrics.LikeCount</span>
                        <span>💬 @item.Tweet.Metrics.ReplyCount</span>
                    </div>

                    <p class="tweet-text">
                        @item.Tweet.Text
                    </p>

                    <a class="tweet-link"
                       href="https://twitter.com/i/web/status/@item.Tweet.Id"
                       target="_blank">
                        Open on X →
                    </a>
                </div>
            }
        </div>
    }
</div>
